<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="550.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.evaluacioncorte2.controller.ProductoController">
    <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>


    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets bottom="10" /></padding>
            <Label text="Buscar:" />
            <TextField fx:id="txtBuscar" promptText="Código o nombre..." prefWidth="180" />
            <Label text="Categoría:" />
            <ComboBox fx:id="cmbFiltroCategoria" prefWidth="120" />
            <CheckBox fx:id="chkSoloExistencias" text="Solo con stock" />
            <Button text="Buscar" onAction="#onBuscar" />
            <Button text="Limpiar" onAction="#onLimpiarFiltros" />
            <Button text="Recargar" onAction="#onRecargar" />
        </HBox>
    </top>


    <center>
        <VBox spacing="5">
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="90" />
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220" />
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="110" />
                    <TableColumn fx:id="colPrecio" text="Precio (C$)" prefWidth="90" />
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="70" />
                </columns>
            </TableView>
            <HBox spacing="20">
                <Label fx:id="lblContador" text="Registros: 0" style="-fx-font-weight: bold;" />
                <Label fx:id="lblEstado" text="Listo." />
            </HBox>
        </VBox>
    </center>


    <right>
        <VBox spacing="10" prefWidth="280">
            <padding><Insets left="10" /></padding>
            <Label text="Formulario" style="-fx-font-weight: bold; -fx-font-size: 14px;" />

            <TextField fx:id="txtId" promptText="ID (Automático)" disable="true" editable="false" />
            <TextField fx:id="txtCodigo" promptText="Código (máx 10)" />
            <TextField fx:id="txtNombre" promptText="Nombre (3 a 80)" />
            <ComboBox fx:id="cmbCategoria" promptText="Categoría..." maxWidth="Infinity" />
            <TextField fx:id="txtPrecio" promptText="Precio (> 0)" />
            <TextField fx:id="txtStock" promptText="Stock (>= 0)" />

            <VBox spacing="5">
                <Button text="Nuevo / Limpiar" maxWidth="Infinity" onAction="#onNuevo" />
                <Button text="Guardar" maxWidth="Infinity" onAction="#onGuardar" />
                <Button text="Actualizar" maxWidth="Infinity" onAction="#onActualizar" />
                <Button text="Eliminar" maxWidth="Infinity" onAction="#onEliminar" />
            </VBox>
        </VBox>
    </right>
</BorderPane>